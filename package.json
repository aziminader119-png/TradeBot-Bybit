{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:frontend": "vite build --outDir dist-next --emptyOutDir",
    "publish:frontend": "node scripts/publish-frontend.mjs",
    "frontend:update": "npm run build:frontend && npm run publish:frontend",
    "frontend:rollback": "node scripts/publish-frontend.mjs --rollback",
    "start": "vite build && tsx server.ts --prod",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "bash tests/run-tests.sh",
    "test:browser": "node tests/browser/symbol-navigation.browser.mjs && node tests/browser/symbol-chart.browser.mjs && node tests/browser/features.browser.mjs",
    "verify:frontend-update": "node tests/frontend-update.verify.mjs",
    "bybit:check": "tsx scripts/bybit-check.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
